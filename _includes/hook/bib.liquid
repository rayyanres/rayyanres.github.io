{%- comment -%}
  Site-local hook (see docs/CUSTOMIZE.md / al_folio_core's _layouts/bib.liquid,
  which calls this automatically if the file exists). Renders a small
  color-coded status pill for each publication based on its journal field,
  since this bibliography mixes published papers with manuscripts still in
  review or in preparation.
{%- endcomment -%}
{% if entry.journal contains 'under review' %}
  <span class="pub-status pub-status-review">Under Review</span>
{% elsif entry.journal contains 'in preparation' %}
  <span class="pub-status pub-status-prep">In Preparation</span>
{% else %}
  <span class="pub-status pub-status-published">Published</span>
{% endif %}
